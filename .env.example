# Datenbank-URL für PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# NextAuth URL (wichtig für OAuth Callbacks)
NEXTAUTH_URL="https://teampayer.de"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# JWT Secret für Token-Generierung
JWT_SECRET="your-secret-key-here"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft/Azure AD OAuth (optional)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Apple Sign In (required for App Store)
# See: https://developer.apple.com/documentation/sign_in_with_apple
APPLE_ID=""
APPLE_SECRET=""

# Apple Sign In (Client-seitig für Native Apps)
NEXT_PUBLIC_APPLE_CLIENT_ID=""
NEXT_PUBLIC_APPLE_REDIRECT_URI=""
NEXT_PUBLIC_API_BASE_URL=""

# Resend API Key für E-Mail-Versand (Registrierungs-, Verifikations-, Passwort-Reset-Mails)
# See: https://resend.com/api-keys
RESEND_API_KEY=""

# App Mode: 'student' | 'teacher' | leave empty for all features
# student = Standard app without teacher/classroom features
# teacher = Teacher app with only classroom management
NEXT_PUBLIC_APP_MODE=""
